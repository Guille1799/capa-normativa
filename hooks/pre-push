#!/bin/sh
# escaparate -- PUNTERO al gancho canonico, proyectos/.claude/githooks/pre-push. No lleva logica
# a proposito: la logica vive en UN fichero y aqui no puede divergir. Lleva $HOME y no la ruta
# entera porque este fichero se versiona en repos publicos.
S="$HOME/proyectos/.claude/githooks/pre-push"
if [ ! -f "$S" ]; then
    echo "pre-push: falta $S -- el escaparate NO se ha ejecutado." >&2
    exit 1
fi
exec sh "$S" "$@"
